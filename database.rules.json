{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nemesis.team')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nemesis.team')"
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && !data.exists() && newData.isString() && newData.val() === auth.uid) || (!newData.exists() && data.val() === auth.uid))"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.token.email === 'admin@nemesis.team'",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['lastSeen', 'source']) && newData.child('lastSeen').isNumber() && (newData.child('source').val() === 'web' || newData.child('source').val() === 'loader')"
      }
    },
    "publicPresence": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['lastSeen']) && newData.child('lastSeen').isNumber()"
      }
    },
    "stats": {
      "registeredCount": {
        ".read": true,
        ".write": "auth != null && (auth.token.email === 'admin@nemesis.team' || (!data.exists() && newData.isNumber()) || (data.exists() && newData.isNumber() && newData.val() === data.val() + 1))"
      }
    }
  }
}
